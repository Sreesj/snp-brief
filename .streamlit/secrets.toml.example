# Copy into the Streamlit Cloud "Secrets" box (or .streamlit/secrets.toml locally, which is git-ignored).
NEBIUS_API_KEY = "your-nebius-key"
SNP_BRIEF_LLM_MODEL = "openai/gpt-oss-20b"     # faster model for summaries
SNP_BRIEF_FORGE_MODEL = "openai/gpt-oss-120b"  # stronger model for Hypothesis Forge and abstract findings
NCBI_API_KEY = ""                              # optional; raises NCBI's limit from 3 to 10 requests per second
SNP_BRIEF_APP_PASSWORD = "choose-a-password"
SNP_BRIEF_FORGE_LIMIT = "20"
